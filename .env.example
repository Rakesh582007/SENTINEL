# Copy to .env (repo root) to override defaults. Every key is prefixed GAW_.
# Keep comments on their own lines.

# replay (default for the demo) or live
GAW_MODE=replay

# nw_border | delhi | north_india | all_india (live polling only)
GAW_REGION=north_india

# JSON list; adsb.fi sees the most aircraft over North India
GAW_SOURCES=["adsb.fi","adsb.lol"]

# Live mode also writes raw recordings. Stop scripts/record.py while the app runs live.
GAW_RECORD_LIVE=true

# Detector tick in seconds
GAW_TICK_S=5

# Replay speed (1-20) and how many of the newest recorded hours to load by default
GAW_REPLAY_SPEED=1
GAW_REPLAY_DEFAULT_HOURS=3
