# Copy to backend/.env (gitignored) and fill in what you need. Never commit a real key.
# Settings are read from backend/.env and from .env at the repo root (backend/.env wins);
# real environment variables beat both. Keep comments on their own lines.

# ---------------------------------------------------------------- AI summary (Gemini)
# Plain-English notes on a hexagon or an incident (GET /api/cells/{h3}/summary,
# GET /api/incidents/{id}/summary, the incident PDF). Detection never depends on it:
# without a key, or offline, a deterministic template summary is used.

# Key from Google AI Studio. Empty = AI off, template only.
GEMINI_API_KEY=

# true / false. false = always the template.
GAW_AI_ENABLED=true

# Models tried in order; the next one is tried on an error, a timeout, quota (429) or an empty answer.
GAW_AI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash

# Seconds per model attempt (2-30). Also the longest the PDF waits for the AI.
GAW_AI_TIMEOUT_S=8

# Seconds a summary is reused while its hexagon / incident is unchanged (10-1800).
GAW_AI_CACHE_TTL_S=120

# Most Gemini calls per minute, all requests together (protects the free quota).
GAW_AI_MAX_PER_MIN=12

# ---------------------------------------------------------------- demo
# Pin the replayed recordings: comma-separated names from data/recordings
# (GET /api/recordings lists them). Empty = the newest 3 hours.
GAW_REPLAY_FILES=
